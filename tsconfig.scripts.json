{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "commonjs",
        "moduleResolution": "node",
        "outDir": "./dist-scripts",
        "target": "ES2020",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "strict": false,
        "noImplicitAny": false,
        "skipLibCheck": true
    },
    "include": [
        "scripts/**/*.ts",
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}