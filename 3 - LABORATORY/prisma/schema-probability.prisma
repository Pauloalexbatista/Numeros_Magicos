// Probability Analysis Database Schema
// Separate database for statistical analysis and probability calculations

generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client-probability"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./probability-lab.db"
}

// ============================================================================
// TABLE 1: Positional Frequency (Absolute Counts)
// ============================================================================
// Tracks how many times each number (1-50) appeared in each position (C1-C5)
// after sorting the 5 numbers in ascending order
//
// Example: If number 25 appeared:
//   - 10 times in position C1 (smallest number)
//   - 45 times in position C2
//   - 80 times in position C3
//   - 50 times in position C4
//   - 15 times in position C5 (largest number)
//   Total: 200 appearances
// ============================================================================

model PositionalFrequency {
  id                Int      @id @default(autoincrement())
  number            Int      @unique // 1-50
  c1_count          Int      @default(0) // Times appeared in 1st position (smallest)
  c2_count          Int      @default(0) // Times appeared in 2nd position
  c3_count          Int      @default(0) // Times appeared in 3rd position (middle)
  c4_count          Int      @default(0) // Times appeared in 4th position
  c5_count          Int      @default(0) // Times appeared in 5th position (largest)
  total_appearances Int      @default(0) // Sum of all positions
  lastUpdated       DateTime @default(now()) @updatedAt

  @@map("positional_frequency")
}

// ============================================================================
// TABLE 2: Positional Probability (Conditional Percentages)
// ============================================================================
// When number X appears in a draw, what % of time is it in each position?
//
// Example: Number 1 will ALWAYS be in C1 (100%), never in other positions
//          Number 25 might be: C1:5%, C2:22%, C3:40%, C4:25%, C5:8%
// ============================================================================

model PositionalProbability {
  id         Int      @id @default(autoincrement())
  number     Int      @unique // 1-50
  c1_percent Float    @default(0) // % of times in C1 when it appears
  c2_percent Float    @default(0) // % of times in C2 when it appears
  c3_percent Float    @default(0) // % of times in C3 when it appears
  c4_percent Float    @default(0) // % of times in C4 when it appears
  c5_percent Float    @default(0) // % of times in C5 when it appears
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("positional_probability")
}

// ============================================================================
// TABLE 3: Deviation Analysis (Observed vs Expected)
// ============================================================================
// Statistical analysis comparing actual frequencies vs theoretical expectations
// Helps identify numbers with anomalous positional behavior
// ============================================================================

model PositionalDeviation {
  id                Int      @id @default(autoincrement())
  number            Int      @unique // 1-50
  c1_observed       Int      @default(0)
  c1_expected       Float    @default(0)
  c1_deviation      Float    @default(0) // (observed - expected) / expected
  c2_observed       Int      @default(0)
  c2_expected       Float    @default(0)
  c2_deviation      Float    @default(0)
  c3_observed       Int      @default(0)
  c3_expected       Float    @default(0)
  c3_deviation      Float    @default(0)
  c4_observed       Int      @default(0)
  c4_expected       Float    @default(0)
  c4_deviation      Float    @default(0)
  c5_observed       Int      @default(0)
  c5_expected       Float    @default(0)
  c5_deviation      Float    @default(0)
  chiSquare         Float    @default(0) // Statistical significance test
  isSignificant     Boolean  @default(false) // Chi-square > threshold
  updatedAt         DateTime @default(now()) @updatedAt

  @@map("positional_deviation")
}

// ============================================================================
// METADATA: Track calculation status and draw coverage
// ============================================================================

model CalculationMetadata {
  id                  Int      @id @default(autoincrement())
  tableName           String   @unique
  lastProcessedDrawId Int      @default(0)
  totalDrawsProcessed Int      @default(0)
  calculatedAt        DateTime @default(now()) @updatedAt

  @@map("calculation_metadata")
}

// ============================================================================
// TABLE 4: Cumulative Exits Counter (from draw 11+)
// ============================================================================
// Tracks cumulative count of appearances for each number up to each draw
// One row per draw, starting from draw 11
//
// Example for draw 100:
// - Number 1 has appeared 18 times total (cumulative)
// - Number 25 has appeared 22 times total (cumulative)
// ============================================================================

model CumulativeExits {
  id              Int      @id @default(autoincrement())
  drawId          Int      @unique
  drawNumber      Int      // Sequential draw number
  drawDate        DateTime
  drawnNumbers    String   // JSON array of 5 numbers drawn (sorted)
  cumulativeCounts String  // JSON object: {"1": 18, "2": 15, ..., "50": 20}
  
  @@index([drawNumber])
  @@map("cumulative_exits")
}

// ============================================================================
// TABLE 5: Consecutive Absence Counter (from draw 11+)
// ============================================================================
// Tracks how many consecutive draws each number has been absent
// One row per draw, starting from draw 11
//
// Example for draw 100:
// - Number 1: 5 (absent for last 5 draws)
// - Number 25: 0 (appeared in this draw)
// - Number 30: 12 (absent for last 12 draws)
// ============================================================================

model ConsecutiveAbsences {
  id              Int      @id @default(autoincrement())
  drawId          Int      @unique
  drawNumber      Int      // Sequential draw number
  drawDate        DateTime
  drawnNumbers    String   // JSON array of 5 numbers drawn (sorted)
  absenceCounts   String   // JSON object: {"1": 5, "2": 0, ..., "50": 12}
  
  @@index([drawNumber])
  @@map("consecutive_absences")
}

// ============================================================================
// TABLE 6: Momentum Score (from draw 11+)
// ============================================================================
// Running score: +1 when number appears, -1 when absent
// One row per draw, starting from draw 11
//
// Example for draw 100:
// - Number 1: +8 (appeared 8 more times than expected)
// - Number 25: -3 (appeared 3 fewer times than expected)
// ============================================================================

model MomentumScore {
  id              Int      @id @default(autoincrement())
  drawId          Int      @unique
  drawNumber      Int      // Sequential draw number
  drawDate        DateTime
  drawnNumbers    String   // JSON array of 5 numbers drawn (sorted)
  momentumScores  String   // JSON object: {"1": 8, "2": -3, ..., "50": 5}
  
  @@index([drawNumber])
  @@map("momentum_score")
}
